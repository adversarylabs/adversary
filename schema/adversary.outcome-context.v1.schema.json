{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adversary.dev/schemas/adversary.outcome-context.v1.schema.json",
  "title": "Adversary Outcome Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "sources", "intent"],
  "properties": {
    "schema_version": { "const": "adversary.outcome-context.v1" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "pull_request"],
      "properties": {
        "provider": { "const": "github" },
        "repository": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "[^\\s\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF]" },
        "pull_request": { "type": "integer", "minimum": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "allOf": [
        {
          "not": {
            "contains": {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "pull_request_title" } }
            },
            "minContains": 2
          }
        },
        {
          "not": {
            "contains": {
              "type": "object",
              "required": ["kind"],
              "properties": { "kind": { "const": "pull_request_body" } }
            },
            "minContains": 2
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "enum": ["pull_request_title", "pull_request_body"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 32768, "pattern": "[^\\s\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF]" }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "confidence",
        "expected_effects",
        "must_preserve",
        "affected_boundaries",
        "ambiguities"
      ],
      "properties": {
        "objective": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "[^\\s\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF]" },
        "confidence": { "enum": ["low", "medium", "high"] },
        "expected_effects": { "$ref": "#/$defs/stringList" },
        "must_preserve": { "$ref": "#/$defs/stringList" },
        "affected_boundaries": { "$ref": "#/$defs/stringList" },
        "ambiguities": { "$ref": "#/$defs/stringList" }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "[^\\s\u0085\u00A0\u1680\u2000-\u200A\u2028\u2029\u202F\u205F\u3000\uFEFF]" }
    }
  }
}
